{
  "name": "easygamehub-bilibili-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --external:sdk --jsx=transform --outfile=dist/bundle.js",
    "test:danmaku": "node scripts/test-danmaku-layout.mjs",
